NODE_ENV=development
PORT=3000
API_GLOBAL_PREFIX=api

# Use 127.0.0.1 + sslmode=disable for local Docker Postgres from your Mac (Prisma Studio, CLI).
# npm prisma:* scripts load this file with Node's `--env-file` (Node 20+); run them from `backend/`.
DATABASE_URL=postgresql://bkr:bkr@127.0.0.1:5432/bkr?schema=public&sslmode=disable

JWT_SECRET=change-me-jwt-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d

PASSWORD_BCRYPT_ROUNDS=12

SWAGGER_ENABLED=true
SWAGGER_PATH=docs

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional — heuristic parking load from Google Directions API (duration vs duration_in_traffic).
# Google Cloud: enable “Directions API”, billing on; use a server/restricted API key.
GOOGLE_DIRECTIONS_API_KEY=
