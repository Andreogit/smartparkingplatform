{
  "name": "bkr-backend",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "db:up": "docker compose -f ../docker-compose.yml up -d postgres",
    "db:ensure": "node --env-file=./.env ./scripts/ensure-postgres.js",
    "start": "npm run db:ensure && npm run prisma:generate && nest start",
    "start:dev": "npm run db:ensure && npm run prisma:generate && nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "prisma:generate": "node --env-file=./.env ./node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prisma:migrate": "node --env-file=./.env ./node_modules/prisma/build/index.js migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "node --env-file=./.env ./node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "node --env-file=./.env ./node_modules/prisma/build/index.js studio --schema prisma/schema.prisma",
    "prisma:status": "node --env-file=./.env ./node_modules/prisma/build/index.js migrate status --schema prisma/schema.prisma",
    "prisma:sql": "node --env-file=./.env ./node_modules/prisma/build/index.js db execute --stdin --schema prisma/schema.prisma",
    "prisma:import-parkings": "npm run prisma:deploy && npm run prisma:generate && node --env-file=./.env ./node_modules/ts-node/dist/bin.js prisma/seed.ts"
  },
  "prisma": {
    "seed": "npm run prisma:deploy && npm run prisma:generate && node --env-file=./.env ./node_modules/ts-node/dist/bin.js prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^6.7.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prisma": "^6.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
